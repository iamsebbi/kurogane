# ==========================================
# Kurogane Monorepo — Exemplu Configurație (.env.example)
# Copiază acest fișier în .env sau .env.local și completează valorile necesare
# ==========================================

# --- API Backend (apps/api) ---
PORT=4000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
OTP_SALT=your_secure_otp_salt_random_string
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://kurogane.vercel.app

# Firebase Admin SDK (Server-Side Verification)
FIREBASE_PROJECT_ID=kurogane-c3c14
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Servicii Externe & Bază de Date Cloud (Supabase PostgreSQL)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
# Sau SUPABASE_ANON_KEY=your_supabase_anon_key
RESEND_API_KEY=re_your_resend_api_key_here

# --- Web Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# Firebase Authentication (Public Client Keys)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy_YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kurogane-c3c14.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kurogane-c3c14
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=kurogane-c3c14.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=141330897882
NEXT_PUBLIC_FIREBASE_APP_ID=1:141330897882:web:5ce77a022ecfdadbce3ee3

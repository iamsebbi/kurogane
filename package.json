{
  "name": "kurogane-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "A modern, resilient, and open media tracking platform for Anime, Donghua, and Manga.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npx concurrently --shell powershell.exe -n \"API,WEB\" -c \"cyan,magenta\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:mobile": "cd apps/mobile && flutter run",
    "dev:mobile:phone": "cd apps/mobile && flutter run -d 46041FDAP000FT",
    "dev:mobile:emulator": "cd apps/mobile && flutter run -d emulator-5554",
    "mobile:reverse": "powershell -ExecutionPolicy Bypass -File scripts/reverse-ports.ps1",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "anime",
    "donghua",
    "manga",
    "media-tracker",
    "anilist-api",
    "watch-order"
  ],
  "author": "Kurogane Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

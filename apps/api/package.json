{
  "name": "@kurogane/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --packages=external",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test:search": "npx ts-node src/test-search.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "start": "node --max-old-space-size=450 dist/index.js"
  },
  "dependencies": {
    "@kurogane/shared": "*",
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.1",
    "prisma": "^5.10.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}


# ==========================================
# Kurogane API — Configurație Mediu (.env.example)
# Copiază acest fișier ca .env sau .env.local și completează cheile necesare
# ==========================================

# Server Port & Mode
PORT=4000
NODE_ENV=development

# Securitate Criptografică (JWT & OTP)
JWT_SECRET=kurogane_super_secret_jwt_key_min_32_characters_long_2026
OTP_SALT=kurogane_secure_otp_salt_random_key_production_ready

# Politică Restricționată CORS (Separate prin virgulă)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://kurogane.vercel.app

# Firebase Admin SDK (Verificare Criptografică Token-uri Google/Firebase pe Server)
FIREBASE_PROJECT_ID=kurogane-c3c14
# Opțional: JSON String al cheii Service Account dacă doriți drepturi administrative complete
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"kurogane-c3c14",...}

# Supabase PostgreSQL Database (Persistență Cloud cu Coadă de Replicare)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
# Sau SUPABASE_ANON_KEY=your_supabase_anon_key

# Serviciu Email Resend (Trimitere OTP & Notificări)
RESEND_API_KEY=re_your_resend_api_key_here
